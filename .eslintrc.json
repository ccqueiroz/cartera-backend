{
  "extends": "@caiocezarqueiroz/eslint-config/settingsGenerator/eslint/node.js",
  "rules": {
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "ts": "never",
        "tsx": "never"
      }
    ],
    "prettier/prettier": [
      "error",
      {
        "endOfLine": "auto"
      }
    ],
    "import/namespace": [
      "warn",
      {
        "allowComputed": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/features/**/*.ts",
        "src/shared/**/*.ts",
        "src/bootstrap/**/*.ts",
        "src/packages/**/*.ts",
        "index.ts"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "error",
        "no-console": "error"
      }
    },
    {
      "files": ["**/*.spec.ts"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "no-console": "off"
      }
    }
  ],
  "settings": {
    "import/resolver": {
      "typescript": { "project": "./tsconfig.json" },
      "node": {
        "extensions": [".ts", ".tsx"]
      }
    }
  }
}
